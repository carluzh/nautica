# Copy to `.env.local`.

# Point the frontend at the backend to run in API MODE. Leave this UNSET to run
# in self-contained MOCK MODE (no backend needed) — the default for frontend work.
NEXT_PUBLIC_API_URL=http://localhost:8080

# World ID needs NOTHING here: the frontend fetches the app_id, pinned action, and
# signed rp_context from the backend (GET /auth/worldid/context). When the backend
# has no real World ID app configured it returns simulated:true and the frontend
# submits a dev proof; otherwise it opens the real IDKit widget automatically.
