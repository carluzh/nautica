# Copy to `.env.local`.

# Point the frontend at the backend to run in API MODE. Leave this UNSET to run
# in self-contained MOCK MODE (no backend needed) — the default for frontend work.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: World App ID for real IDKit login. Without it the frontend sends a
# dev-mock proof, which the server accepts when its WORLD_APP_ID is also unset.
NEXT_PUBLIC_WORLD_APP_ID=
