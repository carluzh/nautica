# ------------------------------------------------------------------------------
# Nautica server config. Copy to `.env` and fill in. Every integration has a
# safe stubbed fallback, so the server runs end-to-end with NONE of these set —
# it just logs which parts are live vs. simulated (see GET /health).
# ------------------------------------------------------------------------------

# Server
PORT=8080
# Comma-separated list of allowed browser origins (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000
# Secret used to sign session tokens (HMAC). Generate: openssl rand -hex 32
SESSION_SECRET=

# World ID 4.0 (Developer Portal). Real verification needs ALL THREE of
# WORLD_APP_ID + WORLD_RP_ID + WORLD_RP_SIGNING_KEY. With any missing, the server
# runs dev-mock (accepts a dev proof, mints a deterministic nullifier). See /health.
#
#   WORLD_APP_ID          app_… — a World ID 4.0 app from https://developer.world.org
#   WORLD_RP_ID           rp_…  — a Relying Party registered on that app (separate id)
#   WORLD_RP_SIGNING_KEY  the RP's secp256k1 private key (hex). SERVER-ONLY SECRET —
#                         signs the rp_context. Never expose to the client.
# Also enable the Selfie Check + Identity Check credentials on the app (access-gated;
# ask World DevRel / the booth to turn them on).
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# Pinned actions (uniqueness scopes). The client never chooses these.
WORLD_ACTION=nautica-login          # Selfie Check one-human login
WORLD_ACTION_PAID=nautica-unlock-paid  # Identity Check gate for paid quests
# Proof environment: production | staging | sandbox (match the World App build you test with).
WORLD_ENV=production
# v4 cloud verify base. The rp_id is appended: {URL}/{rp_id}. Override only if World moves hosts.
WORLD_VERIFY_URL=https://developer.world.org/api/v4/verify

# Google sign-in. Without GOOGLE_CLIENT_ID the server runs dev-mock Google auth.
GOOGLE_CLIENT_ID=
# SIWE (wallet sign-in): the domain a signed message must bind to (match the frontend origin host).
SIWE_DOMAIN=localhost:3000
# Accept dev placeholder wallet signatures (parity with World ID/Google dev-mock). "false" in prod.
SIWE_DEV_BYPASS=true

# 0G Compute (OpenAI-compatible router). Without ZEROG_API_KEY the server
# returns a simulated TEE attestation instead of calling the model.
ZEROG_ROUTER=https://router-api.0g.ai/v1
ZEROG_API_KEY=
ZEROG_MODEL=qwen3-vl-30b

# The Graph subgraph. Without SUBGRAPH_URL the broker returns structured mock
# data shaped exactly like the real queries, so the frontend contract is stable.
SUBGRAPH_URL=
SUBGRAPH_API_KEY=

# Base chain relayer (trusted attestor that records completions + settles USDC).
# Without RELAYER_PRIVATE_KEY the chain service returns simulated tx hashes.
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
RELAYER_PRIVATE_KEY=
QUEST_CONTRACT_ADDRESS=
USDC_ADDRESS=

# Optional: enables the plausibility agent's LLM narration layer (one-sentence
# naturalistic verdict). Off when unset; the deterministic verdict is unchanged.
ANTHROPIC_API_KEY=
