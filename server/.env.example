# ------------------------------------------------------------------------------
# Nautica server config. Copy to `.env` and fill in. Every integration has a
# safe stubbed fallback, so the server runs end-to-end with NONE of these set —
# it just logs which parts are live vs. simulated (see GET /health).
# ------------------------------------------------------------------------------

# Server
PORT=8080
# Comma-separated list of allowed browser origins (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000
# Secret used to sign session tokens (HMAC). Generate: openssl rand -hex 32
SESSION_SECRET=

# World ID (Developer Portal). Without WORLD_APP_ID the server runs in
# dev-mock verification mode (accepts any proof, mints a deterministic nullifier).
# app_staging_… or app_… from https://developer.worldcoin.org
WORLD_APP_ID=
# The action id you configured for the incognito action (one per verified purpose).
WORLD_ACTION=nautica-login
# Verify API base. Override only if World changes hosts.
WORLD_VERIFY_URL=https://developer.worldcoin.org/api/v2/verify

# Google sign-in. Without GOOGLE_CLIENT_ID the server runs dev-mock Google auth.
GOOGLE_CLIENT_ID=
# SIWE (wallet sign-in): the domain a signed message must bind to (match the frontend origin host).
SIWE_DOMAIN=localhost:3000
# Accept dev placeholder wallet signatures (parity with World ID/Google dev-mock). "false" in prod.
SIWE_DEV_BYPASS=true

# 0G Compute (OpenAI-compatible router). Without ZEROG_API_KEY the server
# returns a simulated TEE attestation instead of calling the model.
ZEROG_ROUTER=https://router-api.0g.ai/v1
ZEROG_API_KEY=
ZEROG_MODEL=qwen3-vl-30b

# The Graph subgraph. Without SUBGRAPH_URL the broker returns structured mock
# data shaped exactly like the real queries, so the frontend contract is stable.
SUBGRAPH_URL=
SUBGRAPH_API_KEY=

# Base chain relayer (trusted attestor that records completions + settles USDC).
# Without RELAYER_PRIVATE_KEY the chain service returns simulated tx hashes.
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
RELAYER_PRIVATE_KEY=
QUEST_CONTRACT_ADDRESS=
USDC_ADDRESS=
